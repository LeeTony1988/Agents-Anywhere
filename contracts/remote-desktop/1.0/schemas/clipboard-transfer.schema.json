{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agents-anywhere:remote-desktop:1.0:clipboard-transfer",
  "title": "RemoteDesktopClipboardTransfer",
  "description": "Chunked text clipboard transfer used when the payload exceeds one reliable LiveKit data packet. A 64 KiB UTF-8 text is split into at most 8 chunks of at most 8 KiB raw bytes; each chunk is base64 encoded and stays under the 15 KiB reliable packet budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "t",
    "a",
    "transferId"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "t": {
      "const": "clipboard_transfer"
    },
    "a": {
      "enum": [
        "begin",
        "chunk",
        "end",
        "ack",
        "cancel"
      ]
    },
    "transferId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "mime": {
      "const": "text/plain"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "totalChunks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "dataBase64": {
      "type": "string",
      "maxLength": 16384
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "enum": [
        "timeout",
        "cancelled",
        "policy"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "a": {
            "const": "begin"
          }
        },
        "required": [
          "a"
        ]
      },
      "then": {
        "required": [
          "mime",
          "size",
          "totalChunks",
          "sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "a": {
            "const": "chunk"
          }
        },
        "required": [
          "a"
        ]
      },
      "then": {
        "required": [
          "index",
          "dataBase64"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "a": {
            "const": "cancel"
          }
        },
        "required": [
          "a"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ],
  "x-direction": "bidirectional",
  "x-contract-version": "1.0"
}
